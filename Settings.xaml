<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Power Timer — настройки" Width="510" Height="720" WindowStartupLocation="CenterOwner"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 FontFamily="Segoe UI" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
 <Border CornerRadius="18" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
  <Grid Margin="22,18,22,18">
   <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="SettingsDrag" Background="Transparent">
    <TextBlock Text="Настройки" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock x:Name="SettingsTestBadge" Text="ТЕСТ" Foreground="{DynamicResource UrgentBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,43,0" Visibility="Collapsed"/>
    <Button x:Name="SettingsClose" Content="×" FontSize="20" Width="32" Height="32" HorizontalAlignment="Right" Padding="0" AutomationProperties.Name="Закрыть настройки"/>
   </Grid>
   <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,14" Padding="0,0,5,0">
    <StackPanel>
     <Border Style="{StaticResource SettingsSection}">
      <StackPanel>
       <TextBlock Text="Оформление" Style="{StaticResource SectionHeading}"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
        <TextBlock Text="Тема" VerticalAlignment="Center" FontSize="13"/>
        <ComboBox x:Name="ThemeSelect" Grid.Column="1" SelectedIndex="0" AutomationProperties.Name="Тема">
         <ComboBoxItem Content="Тёмная" Tag="dark"/><ComboBoxItem Content="Светлая" Tag="light"/><ComboBoxItem Content="Системная" Tag="system"/>
        </ComboBox>
       </Grid>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource SettingsSection}">
      <StackPanel>
       <TextBlock Text="Таймер" Style="{StaticResource SectionHeading}"/>
       <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/><ColumnDefinition Width="24"/><ColumnDefinition Width="58"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
        <TextBlock Text="Время по умолчанию" VerticalAlignment="Center" FontSize="13"/>
        <TextBox x:Name="DefaultHours" Grid.Column="1" Text="2" MaxLength="3" AutomationProperties.Name="Часы по умолчанию"/>
        <TextBlock Text="ч" Grid.Column="2" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBox x:Name="DefaultMinutes" Grid.Column="3" Text="0" MaxLength="2" AutomationProperties.Name="Минуты по умолчанию"/>
        <TextBlock Text="мин" Grid.Column="4" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
       </Grid>
       <TextBlock Text="Быстрые интервалы, мин" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
       <UniformGrid Columns="4" Rows="2" Margin="-3,0,-3,0">
        <TextBox x:Name="Preset0" Text="10" MaxLength="5" Margin="3" AutomationProperties.Name="Интервал 1 в минутах"/>
        <TextBox x:Name="Preset1" Text="15" MaxLength="5" Margin="3" AutomationProperties.Name="Интервал 2 в минутах"/>
        <TextBox x:Name="Preset2" Text="30" MaxLength="5" Margin="3" AutomationProperties.Name="Интервал 3 в минутах"/>
        <TextBox x:Name="Preset3" Text="60" MaxLength="5" Margin="3" AutomationProperties.Name="Интервал 4 в минутах"/>
        <TextBox x:Name="Preset4" Text="120" MaxLength="5" Margin="3" AutomationProperties.Name="Интервал 5 в минутах"/>
        <TextBox x:Name="Preset5" Text="180" MaxLength="5" Margin="3" AutomationProperties.Name="Интервал 6 в минутах"/>
        <TextBox x:Name="Preset6" Text="240" MaxLength="5" Margin="3" AutomationProperties.Name="Интервал 7 в минутах"/>
        <TextBlock Text="Своё время" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
       </UniformGrid>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource SettingsSection}">
      <StackPanel>
       <TextBlock Text="Поведение" Style="{StaticResource SectionHeading}"/>
       <CheckBox x:Name="KeepAwakeCheck" Content="Не засыпать во время отсчёта"/>
       <CheckBox x:Name="AutostartCheck" Content="Запускать вместе с Windows"/>
       <CheckBox x:Name="StartupTrayCheck" Content="При автозапуске открывать в трее"/>
       <CheckBox x:Name="CloseToTrayCheck" Content="При закрытии сворачивать в трей"/>
       <CheckBox x:Name="MinimizeToTrayCheck" Content="При сворачивании убирать в трей"/>
       <CheckBox x:Name="NotifyCheck" Content="Уведомлять за минуту до действия"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource SettingsSection}" Margin="0">
      <StackPanel>
       <TextBlock Text="Виджет" Style="{StaticResource SectionHeading}"/>
       <CheckBox x:Name="WidgetTopmostCheck" Content="Поверх других окон"/>
       <CheckBox x:Name="WidgetRememberPositionCheck" Content="Запоминать положение"/>
       <Grid Margin="0,10,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
        <TextBlock Text="Размер" VerticalAlignment="Center" FontSize="13"/>
        <ComboBox x:Name="WidgetSizeSelect" Grid.Column="1" SelectedIndex="0" AutomationProperties.Name="Размер виджета">
         <ComboBoxItem Content="Маленький" Tag="small"/><ComboBoxItem Content="Средний" Tag="medium"/><ComboBoxItem Content="Крупный" Tag="large"/>
        </ComboBox>
       </Grid>
       <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
        <TextBlock Text="Непрозрачность" VerticalAlignment="Center" FontSize="13"/>
        <Slider x:Name="WidgetOpacitySlider" Grid.Column="1" Minimum="60" Maximum="100" Value="100" TickFrequency="10" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="False" VerticalAlignment="Center" AutomationProperties.Name="Непрозрачность виджета"/>
        <TextBlock x:Name="WidgetOpacityText" Grid.Column="2" Text="100%" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
       </Grid>
       <Button x:Name="ResetWidgetPosition" Content="Сбросить положение" HorizontalAlignment="Left" FontSize="12" Padding="12,7"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <StackPanel Grid.Row="2">
    <TextBlock x:Name="SettingsError" Text="" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" FontSize="12" Margin="0,0,0,10" Visibility="Collapsed"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Button x:Name="CancelSettingsButton" Content="Отмена" Margin="0,0,6,0" Height="40"/>
     <Button x:Name="SaveSettingsButton" Grid.Column="1" Content="Сохранить" Margin="6,0,0,0" Height="40" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderBrush="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
    </Grid>
   </StackPanel>
  </Grid>
 </Border>
</Window>
