<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Power Timer — настройки" Width="510" Height="720" WindowStartupLocation="CenterOwner"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 FontFamily="Segoe UI" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
 <Window.Resources>
  <Style x:Key="PresetEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="Margin" Value="3"/>
   <Setter Property="MaxLength" Value="5"/>
   <Setter Property="Padding" Value="5,5"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TextBox">
      <Border x:Name="PresetFrame" CornerRadius="8" SnapsToDevicePixels="True" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="мин" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="PresetFrame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Border CornerRadius="18" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
  <Grid Margin="22,18,22,18">
   <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="SettingsDrag" Background="Transparent">
    <TextBlock Text="Настройки" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock x:Name="SettingsTestBadge" Text="ТЕСТ" Foreground="{DynamicResource UrgentBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,43,0" Visibility="Collapsed"/>
    <Button x:Name="SettingsClose" Content="×" FontSize="20" Width="32" Height="32" HorizontalAlignment="Right" Padding="0" AutomationProperties.Name="Закрыть настройки"/>
   </Grid>
   <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,14" Padding="0,0,5,0">
    <StackPanel>
     <Border Style="{StaticResource SettingsSection}">
      <StackPanel>
       <TextBlock Text="Оформление" Style="{StaticResource SectionHeading}"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
        <TextBlock Text="Тема" VerticalAlignment="Center" FontSize="13"/>
        <ComboBox x:Name="ThemeSelect" Grid.Column="1" SelectedIndex="0" AutomationProperties.Name="Тема">
         <ComboBoxItem Content="Тёмная" Tag="dark"/><ComboBoxItem Content="Светлая" Tag="light"/><ComboBoxItem Content="Системная" Tag="system"/>
        </ComboBox>
       </Grid>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource SettingsSection}">
      <StackPanel>
       <TextBlock Text="Таймер" Style="{StaticResource SectionHeading}"/>
       <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
        <TextBlock Text="Действие по умолчанию" VerticalAlignment="Center" FontSize="13"/>
        <ComboBox x:Name="DefaultActionSelect" Grid.Column="1" SelectedIndex="0" AutomationProperties.Name="Действие по умолчанию">
         <ComboBoxItem Content="Выключение" Tag="shutdown"/>
         <ComboBoxItem Content="Гибернация" Tag="hibernate"/>
        </ComboBox>
       </Grid>
       <UniformGrid Columns="4" Rows="2" Margin="-3,0,-3,0">
        <Border Margin="3" CornerRadius="8" Background="{DynamicResource DefaultPresetBg}">
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="Preset0" Style="{StaticResource PresetEditor}" Margin="0" Padding="1,5" Background="Transparent" BorderBrush="Transparent" AutomationProperties.Name="Первый интервал по умолчанию в минутах"/>
          <Button x:Name="DefaultPresetHelp" Grid.Column="1" Content="?" Width="20" Height="20" Margin="0,0,4,0" Padding="0" VerticalAlignment="Center"
                  Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" AutomationProperties.Name="Что означает первый интервал">
           <Button.Template>
            <ControlTemplate TargetType="Button">
             <Border x:Name="HelpCircle" CornerRadius="10" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
             </Border>
             <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HelpCircle" Property="Background" Value="{DynamicResource SurfaceBg}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HelpCircle" Property="BorderThickness" Value="2"/></Trigger>
             </ControlTemplate.Triggers>
            </ControlTemplate>
           </Button.Template>
          </Button>
         </Grid>
        </Border>
        <TextBox x:Name="Preset1" Style="{StaticResource PresetEditor}" AutomationProperties.Name="Интервал 2 в минутах"/>
        <TextBox x:Name="Preset2" Style="{StaticResource PresetEditor}" AutomationProperties.Name="Интервал 3 в минутах"/>
        <TextBox x:Name="Preset3" Style="{StaticResource PresetEditor}" AutomationProperties.Name="Интервал 4 в минутах"/>
        <TextBox x:Name="Preset4" Style="{StaticResource PresetEditor}" AutomationProperties.Name="Интервал 5 в минутах"/>
        <TextBox x:Name="Preset5" Style="{StaticResource PresetEditor}" AutomationProperties.Name="Интервал 6 в минутах"/>
        <TextBox x:Name="Preset6" Style="{StaticResource PresetEditor}" AutomationProperties.Name="Интервал 7 в минутах"/>
        <TextBlock Text="Своё время" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
       </UniformGrid>
       <TextBlock x:Name="DefaultPresetExplanation" Text="При запуске приложения автоматически выбирается первый интервал. Здесь можно изменить его длительность в минутах." Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource SettingsSection}">
      <StackPanel>
       <TextBlock Text="Ко времени" Style="{StaticResource SectionHeading}"/>
       <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
        <TextBlock Text="Выбор даты" VerticalAlignment="Center" FontSize="13"/>
        <ComboBox x:Name="ScheduleDateOption" Grid.Column="1" SelectedIndex="0" AutomationProperties.Name="Выбор даты">
         <ComboBoxItem Content="Дата и время" Tag="date"/>
         <ComboBoxItem Content="Только время" Tag="time"/>
        </ComboBox>
       </Grid>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
        <TextBlock Text="Начальное время" VerticalAlignment="Center" FontSize="13"/>
        <ComboBox x:Name="ScheduleTimeOption" Grid.Column="1" SelectedIndex="0" AutomationProperties.Name="Начальное время">
         <ComboBoxItem Content="Через час" Tag="later"/>
         <ComboBoxItem Content="Ближайший полный час" Tag="hour"/>
        </ComboBox>
       </Grid>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource SettingsSection}">
      <StackPanel>
       <TextBlock Text="Поведение" Style="{StaticResource SectionHeading}"/>
       <CheckBox x:Name="KeepAwakeCheck" Content="Не засыпать во время отсчёта"/>
       <CheckBox x:Name="AutostartCheck" Content="Запускать вместе с Windows"/>
       <CheckBox x:Name="StartupTrayCheck" Content="При автозапуске открывать в трее"/>
       <CheckBox x:Name="CloseToTrayCheck" Content="При закрытии сворачивать в трей"/>
       <CheckBox x:Name="MinimizeToTrayCheck" Content="При сворачивании убирать в трей"/>
       <CheckBox x:Name="NotifyCheck" Content="Уведомлять за минуту до действия"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource SettingsSection}" Margin="0">
      <StackPanel>
       <TextBlock Text="Виджет" Style="{StaticResource SectionHeading}"/>
       <CheckBox x:Name="WidgetTopmostCheck" Content="Поверх других окон"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <CheckBox x:Name="WidgetRememberPositionCheck" Content="Запоминать положение"/>
        <Button x:Name="ResetWidgetPosition" Grid.Column="1" Content="Вернуть в угол" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" Padding="12,7"
                ToolTip="После сохранения виджет вернётся в правый верхний угол экрана." AutomationProperties.Name="Вернуть виджет в правый верхний угол"/>
       </Grid>
       <Grid Margin="0,10,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
        <TextBlock Text="Размер" VerticalAlignment="Center" FontSize="13"/>
        <ComboBox x:Name="WidgetSizeSelect" Grid.Column="1" SelectedIndex="0" AutomationProperties.Name="Размер виджета">
         <ComboBoxItem Content="Маленький" Tag="small"/><ComboBoxItem Content="Средний" Tag="medium"/><ComboBoxItem Content="Крупный" Tag="large"/>
        </ComboBox>
       </Grid>
       <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
        <TextBlock Text="Непрозрачность" VerticalAlignment="Center" FontSize="13"/>
        <Slider x:Name="WidgetOpacitySlider" Grid.Column="1" Minimum="60" Maximum="100" Value="100" TickFrequency="10" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="False" VerticalAlignment="Center" AutomationProperties.Name="Непрозрачность виджета"/>
        <TextBlock x:Name="WidgetOpacityText" Grid.Column="2" Text="100%" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
       </Grid>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <StackPanel Grid.Row="2">
    <TextBlock x:Name="SettingsError" Text="" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" FontSize="12" Margin="0,0,0,10" Visibility="Collapsed"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Button x:Name="CancelSettingsButton" Content="Отмена" Margin="0,0,6,0" Height="40"/>
     <Button x:Name="SaveSettingsButton" Grid.Column="1" Content="Сохранить" Margin="6,0,0,0" Height="40" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderBrush="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
    </Grid>
   </StackPanel>
  </Grid>
 </Border>
</Window>
