<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Своё время" Width="336" SizeToContent="Height" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
 <Border Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20">
  <StackPanel>
   <TextBlock Text="Своё время" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,18"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="128"/></Grid.ColumnDefinitions>
    <TextBox x:Name="CustomValue" Text="120" FontSize="20" MaxLength="16" Margin="0,0,10,0" AutomationProperties.Name="Длительность"/>
    <ComboBox x:Name="CustomUnit" Grid.Column="1" SelectedIndex="0" AutomationProperties.Name="Единица времени"><ComboBoxItem Content="Минуты" Tag="minutes"/><ComboBoxItem Content="Часы" Tag="hours"/></ComboBox>
   </Grid>
   <TextBlock x:Name="CustomError" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ErrorBrush}" Visibility="Collapsed" Margin="0,10,0,0"/>
   <UniformGrid Columns="2" Margin="-3,18,-3,0"><Button x:Name="CustomCancel" Content="Отмена" Margin="3,0"/><Button x:Name="CustomAccept" IsDefault="True" Content="Выбрать" Margin="3,0" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"/></UniformGrid>
  </StackPanel>
 </Border>
</Window>