<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Power Timer — виджет" SizeToContent="WidthAndHeight" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
 <Border x:Name="WidgetRoot" CornerRadius="12" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,7,6,7">
  <Grid x:Name="WidgetDrag" MinHeight="32" Background="Transparent">
   <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="WidgetCountdown" Text="00:00:00" FontFamily="Consolas" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
   <StackPanel x:Name="WidgetControls" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed" Margin="3,0,5,0">
    <Border Background="{DynamicResource RaisedBg}" CornerRadius="8" Padding="2" Margin="0,0,7,0">
     <StackPanel Orientation="Horizontal">
      <Button x:Name="WidgetPause" FontFamily="Segoe MDL2 Assets" Content="&#xE769;" FontSize="12" Padding="0" Width="28" Height="28" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Пауза"/>
      <Button x:Name="WidgetCancel" Content="×" FontSize="20" Padding="0" Width="28" Height="28" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource DangerBrush}" AutomationProperties.Name="Отменить таймер"/>
     </StackPanel>
    </Border>
    <Border Background="{DynamicResource RaisedBg}" CornerRadius="8" Padding="2">
     <StackPanel Orientation="Horizontal">
      <Button x:Name="WidgetOpenMain" Content="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Открыть таймер"/>
      <Button x:Name="WidgetHide" Content="—" FontSize="14" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Скрыть в трей"/>
     </StackPanel>
    </Border>
   </StackPanel>
   <Button x:Name="WidgetExpandButton" Grid.Column="2" FontFamily="Segoe MDL2 Assets" Content="&#xE76C;" FontSize="11" Height="28" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Показать управление"/>
  </Grid>
 </Border>
</Window>